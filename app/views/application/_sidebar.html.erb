<aside class="fixed left-0 top-0 h-full w-16 bg-parchment border-r border-parchment-dark flex flex-col items-center py-5 z-50 select-none">

  <%# ── Navigation icons ───────────────────────────────────────────── %>
  <nav class="flex flex-col items-center gap-1 flex-1 w-full pt-2">

    <%# Home — textes %>
    <%= link_to root_path,
          class: "sidebar-icon-link #{current_page?(root_path) ? 'text-saffron bg-parchment-hover' : 'text-stone-400 hover:text-stone-800 hover:bg-parchment-hover'}",
          title: "Bibliothèque" do %>
      <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.7">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25" />
      </svg>
      <span class="sidebar-tooltip">Bibliothèque</span>
    <% end %>

    <%# Recherche %>
    <%= link_to search_path,
          class: "sidebar-icon-link #{current_page?(search_path) ? 'text-saffron bg-parchment-hover' : 'text-stone-400 hover:text-stone-800 hover:bg-parchment-hover'}",
          title: "Recherche" do %>
      <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.7">
        <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z" />
      </svg>
      <span class="sidebar-tooltip">Recherche</span>
    <% end %>

    <% if Current.user&.admin? %>
      <div class="w-6 border-t border-parchment-dark my-2"></div>

      <%= link_to inventory_path,
            class: "sidebar-icon-link #{current_page?(inventory_path) ? 'text-saffron bg-parchment-hover' : 'text-stone-400 hover:text-stone-800 hover:bg-parchment-hover'}",
            title: "Inventaire NAS" do %>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.7">
          <path stroke-linecap="round" stroke-linejoin="round" d="M20.25 6.375c0 2.278-3.694 4.125-8.25 4.125S3.75 8.653 3.75 6.375m16.5 0c0-2.278-3.694-4.125-8.25-4.125S3.75 4.097 3.75 6.375m16.5 0v11.25c0 2.278-3.694 4.125-8.25 4.125s-8.25-1.847-8.25-4.125V6.375m16.5 5.625c0 2.278-3.694 4.125-8.25 4.125s-8.25-1.847-8.25-4.125" />
        </svg>
        <span class="sidebar-tooltip">Inventaire NAS</span>
      <% end %>

      <% pending_count = AiTriageProposal.pending_review.count rescue 0 %>
      <%= link_to triage_index_path,
            class: "sidebar-icon-link relative #{request.path.start_with?('/triage') ? 'text-saffron bg-parchment-hover' : 'text-stone-400 hover:text-stone-800 hover:bg-parchment-hover'}",
            title: "Triage IA" do %>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.7">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09z" />
        </svg>
        <% if pending_count > 0 %>
          <span class="absolute top-0.5 right-0.5 w-2 h-2 bg-saffron rounded-full"></span>
        <% end %>
        <span class="sidebar-tooltip">Triage IA<%= pending_count > 0 ? " (#{pending_count})" : "" %></span>
      <% end %>

      <%= link_to admin_path,
            class: "sidebar-icon-link #{current_page?(admin_path) ? 'text-saffron bg-parchment-hover' : 'text-stone-400 hover:text-stone-800 hover:bg-parchment-hover'}",
            title: "Administration" do %>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.7">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9.594 3.94c.09-.542.56-.94 1.11-.94h2.593c.55 0 1.02.398 1.11.94l.213 1.281c.063.374.313.686.645.87.074.04.147.083.22.127.324.196.72.257 1.075.124l1.217-.456a1.125 1.125 0 011.37.49l1.296 2.247a1.125 1.125 0 01-.26 1.431l-1.003.827c-.293.24-.438.613-.431.992a6.759 6.759 0 010 .255c-.007.378.138.75.43.99l1.005.828c.424.35.534.954.26 1.43l-1.298 2.247a1.125 1.125 0 01-1.369.491l-1.217-.456c-.355-.133-.75-.072-1.076.124a6.57 6.57 0 01-.22.128c-.331.183-.581.495-.644.869l-.213 1.28c-.09.543-.56.941-1.11.941h-2.594c-.55 0-1.02-.398-1.11-.94l-.213-1.281c-.062-.374-.312-.686-.644-.87a6.52 6.52 0 01-.22-.127c-.325-.196-.72-.257-1.076-.124l-1.217.456a1.125 1.125 0 01-1.369-.49l-1.297-2.247a1.125 1.125 0 01.26-1.431l1.004-.827c.292-.24.437-.613.43-.992a6.932 6.932 0 010-.255c.007-.378-.138-.75-.43-.99l-1.004-.828a1.125 1.125 0 01-.26-1.43l1.297-2.247a1.125 1.125 0 011.37-.491l1.216.456c.356.133.751.072 1.076-.124.072-.044.146-.087.22-.128.332-.183.582-.495.644-.869l.214-1.281z" />
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
        </svg>
        <span class="sidebar-tooltip">Administration</span>
      <% end %>
    <% end %>

  </nav>

</aside>
