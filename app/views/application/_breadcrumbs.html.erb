<nav class="breadcrumb-parchment" aria-label="Breadcrumb">
  <%= link_to root_path do %>
    <svg class="w-3.5 h-3.5 inline -mt-0.5 mr-1" fill="currentColor" viewBox="0 0 20 20">
      <path d="m19.707 9.293-2-2-7-7a1 1 0 0 0-1.414 0l-7 7-2 2a1 1 0 0 0 1.414 1.414L2 10.414V18a2 2 0 0 0 2 2h3a1 1 0 0 0 1-1v-4a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v4a1 1 0 0 0 1 1h3a2 2 0 0 0 2-2v-7.586l.293.293a1 1 0 0 0 1.414-1.414Z"/>
    </svg>Bibliothèque
  <% end %>

  <% @breadcrumbs.each_with_index do |breadcrumb, index| %>
    <span class="sep mx-1">/</span>
    <% if index == @breadcrumbs.length - 1 %>
      <span class="current"><%= breadcrumb[:label] %></span>
    <% else %>
      <%= link_to breadcrumb[:label], breadcrumb[:path] %>
    <% end %>
  <% end %>
</nav>
