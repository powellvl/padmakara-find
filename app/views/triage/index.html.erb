<div class="max-w-5xl mx-auto px-4 py-8">
  <div class="flex items-center justify-between mb-6">
    <h1 class="text-2xl font-bold text-gray-900">File d'attente — Triage IA</h1>
  </div>

  <%# ── Stats ── %>
  <div class="grid grid-cols-3 gap-4 mb-8">
    <%= render "inventory/stat_card", label: "En attente de relecture", value: @stats[:pending] %>
    <%= render "inventory/stat_card", label: "Acceptés",                value: @stats[:accepted] %>
    <%= render "inventory/stat_card", label: "Ignorés / rejetés",       value: @stats[:skipped] %>
  </div>

  <% if @awaiting_triage > 0 %>
    <p class="mb-6 text-sm text-amber-700 bg-amber-50 border border-amber-200 rounded px-4 py-2">
      <%= @awaiting_triage %> fichier(s) extrait(s) n'ont pas encore été soumis à l'IA.
      Ils seront traités automatiquement via <code>TriageFileJob</code> après le prochain scan.
    </p>
  <% end %>

  <% if @pending.any? %>
    <div class="space-y-3">
      <% @pending.each do |proposal| %>
        <% cf = proposal.catalogued_file %>
        <% loc = cf.active_locations.first %>
        <div class="flex items-center justify-between rounded-lg border border-gray-200 bg-white px-4 py-3 shadow-sm">
          <div class="min-w-0 flex-1">
            <p class="truncate text-sm font-medium text-gray-900">
              <%= loc&.filename || cf.sha256_checksum.first(16) %>
            </p>
            <p class="text-xs text-gray-500 truncate"><%= loc&.path %></p>
            <div class="mt-1 flex gap-2">
              <span class="text-xs text-gray-500"><%= cf.content_type %></span>
              <span class="text-xs text-gray-500"><%= number_to_human_size(cf.byte_size) %></span>
              <span class="text-xs font-medium
                <%= proposal.confidence == 'high' ? 'text-green-700' :
                    proposal.confidence == 'medium' ? 'text-amber-700' : 'text-red-700' %>">
                Confiance : <%= proposal.confidence %>
              </span>
            </div>
          </div>
          <div class="ml-4 flex gap-2 shrink-0">
            <%= link_to "Relire →", triage_path(proposal),
                  class: "rounded bg-indigo-600 px-3 py-1.5 text-sm font-semibold text-white hover:bg-indigo-700" %>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <p class="text-center text-gray-400 py-12">
      Aucune proposition en attente de relecture.<br>
      <span class="text-sm">Lancez un scan depuis l'<%= link_to "inventaire", inventory_path, class: "underline" %> pour démarrer l'extraction et le triage.</span>
    </p>
  <% end %>
</div>
