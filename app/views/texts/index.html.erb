<% content_for :title, "Bibliothèque" %>

<div class="px-6 py-6 max-w-7xl mx-auto">

  <% if notice %>
    <p class="mb-4 rounded-lg bg-green-50 border border-green-200 px-4 py-2 text-green-800 text-sm"><%= notice %></p>
  <% end %>

  <%# ── Pipeline admin ────────────────────────────────────────────────── %>
  <% if Current.user&.admin? && @pipeline %>
    <div class="rounded-xl border border-stone-200 bg-white/70 p-4 mb-8 shadow-sm">
      <p class="text-xs font-bold text-stone-400 uppercase tracking-widest mb-3">Pipeline NAS</p>
      <div class="flex flex-wrap items-center gap-2">

        <%= link_to inventory_path, class: "group flex items-center gap-2 rounded-lg bg-parchment border border-parchment-dark px-3 py-2 hover:border-saffron transition text-sm" do %>
          <span class="text-xl font-bold text-stone-900 tabular-nums"><%= @pipeline[:scanned] %></span>
          <span class="text-stone-500 group-hover:text-saffron text-xs">actifs</span>
        <% end %>

        <span class="text-stone-300">→</span>

        <%= link_to inventory_path, class: "group flex items-center gap-2 rounded-lg bg-parchment border border-parchment-dark px-3 py-2 hover:border-saffron transition text-sm" do %>
          <span class="text-xl font-bold text-stone-900 tabular-nums"><%= @pipeline[:extracted] %></span>
          <span class="text-stone-500 group-hover:text-saffron text-xs">extraits</span>
        <% end %>

        <span class="text-stone-300">→</span>

        <% triage_alert = @pipeline[:pending_triage] > 0 %>
        <%= link_to triage_index_path, class: "group flex items-center gap-2 rounded-lg px-3 py-2 transition text-sm border #{triage_alert ? 'bg-amber-50 border-amber-300 hover:border-amber-500' : 'bg-parchment border-parchment-dark hover:border-saffron'}" do %>
          <span class="text-xl font-bold tabular-nums <%= triage_alert ? 'text-amber-700' : 'text-stone-900' %>"><%= @pipeline[:pending_triage] %></span>
          <span class="text-xs <%= triage_alert ? 'text-amber-600' : 'text-stone-500 group-hover:text-saffron' %>">à trier<%= triage_alert ? " ●" : "" %></span>
        <% end %>

        <span class="text-stone-300">→</span>

        <div class="flex items-center gap-2 rounded-lg bg-parchment border border-green-200 px-3 py-2 text-sm">
          <span class="text-xl font-bold text-green-700 tabular-nums"><%= @pipeline[:triaged] %></span>
          <span class="text-stone-500 text-xs">catalogués</span>
        </div>

        <div class="ml-auto flex gap-2">
          <%= button_to "Lancer un scan", trigger_scan_inventory_path, method: :post,
                class: "rounded-lg bg-stone-800 px-3 py-1.5 text-xs font-semibold text-white hover:bg-stone-700 transition" %>
          <% if triage_alert %>
            <%= link_to "Relire →", triage_index_path,
                  class: "rounded-lg bg-saffron px-3 py-1.5 text-xs font-semibold text-white hover:bg-saffron-dark transition" %>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>

  <%# ── Header section + filtres ──────────────────────────────────────── %>
  <div class="flex items-center justify-between mb-5">
    <div>
      <p class="text-xs font-bold text-stone-400 uppercase tracking-widest mb-0.5">Collection</p>
      <h1 class="text-2xl font-bold text-stone-900">Textes de prières</h1>
    </div>
    <div class="flex items-center gap-3">
      <%# Bouton filtres %>
      <div data-controller="filters"
           data-filters-clear-url-value="<%= texts_path %>"
           data-filters-has-active-filters-value="<%= (@selected_school_ids.any? || @selected_deity_ids.any? || @selected_tag_ids.any?).to_s %>">

        <button class="inline-flex items-center gap-1.5 rounded-lg border border-parchment-dark bg-white px-3 py-2 text-sm text-stone-600 hover:border-saffron hover:text-saffron transition shadow-sm"
                data-filters-target="toggleButton"
                data-action="click->filters#toggleFilters">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.7">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 3c2.755 0 5.455.232 8.083.678.533.09.917.556.917 1.096v1.044a2.25 2.25 0 01-.659 1.591l-5.432 5.432a2.25 2.25 0 00-.659 1.591v2.927a2.25 2.25 0 01-1.244 2.013L9.75 21v-6.568a2.25 2.25 0 00-.659-1.591L3.659 7.409A2.25 2.25 0 013 5.818V4.774c0-.54.384-1.006.917-1.096A48.32 48.32 0 0112 3z" />
          </svg>
          <span data-filters-target="filterText">Filtres</span>
        </button>

        <%# Panneau filtres %>
        <div class="filters-section mt-3 absolute right-6 z-20 w-96 bg-white rounded-xl shadow-lg border border-parchment-dark p-4"
             data-filters-target="filtersSection"
             style="display:none">
          <%= form_with url: texts_path, method: :get, local: true do |form| %>
            <div class="space-y-4">
              <div>
                <p class="text-xs font-bold text-stone-400 uppercase tracking-widest mb-2">Écoles</p>
                <div class="flex flex-wrap gap-1.5">
                  <%= form.collection_check_boxes :school_ids, @schools, :id, :name, { checked: @selected_school_ids } do |b| %>
                    <label class="pill-filter" data-category="school" data-action="click->filters#togglePill">
                      <%= b.check_box(class: "pill-checkbox") %>
                      <span class="pill-content"><%= b.text %></span>
                    </label>
                  <% end %>
                </div>
              </div>
              <div>
                <p class="text-xs font-bold text-stone-400 uppercase tracking-widest mb-2">Déités</p>
                <div class="flex flex-wrap gap-1.5">
                  <%= form.collection_check_boxes :deity_ids, @deities, :id, :name_english, { checked: @selected_deity_ids } do |b| %>
                    <label class="pill-filter" data-category="deity" data-action="click->filters#togglePill">
                      <%= b.check_box(class: "pill-checkbox") %>
                      <span class="pill-content"><%= b.text %></span>
                    </label>
                  <% end %>
                </div>
              </div>
              <div>
                <p class="text-xs font-bold text-stone-400 uppercase tracking-widest mb-2">Tags</p>
                <div class="flex flex-wrap gap-1.5">
                  <%= form.collection_check_boxes :tag_ids, @tags, :id, :name, { checked: @selected_tag_ids } do |b| %>
                    <label class="pill-filter" data-category="tag" data-action="click->filters#togglePill">
                      <%= b.check_box(class: "pill-checkbox") %>
                      <span class="pill-content"><%= b.text %></span>
                    </label>
                  <% end %>
                </div>
              </div>
            </div>
            <div class="mt-4 flex gap-2">
              <%= form.submit "Appliquer", class: "flex-1 rounded-lg bg-saffron px-3 py-2 text-sm font-semibold text-white hover:bg-saffron-dark transition cursor-pointer" %>
              <button type="button"
                      class="rounded-lg border border-parchment-dark px-3 py-2 text-sm text-stone-500 hover:text-saffron transition"
                      data-filters-target="clearButton"
                      data-action="click->filters#clearFilters">
                Effacer
              </button>
            </div>
          <% end %>
        </div>
      </div>

      <% if Current.user&.admin? %>
        <%= link_to new_text_path,
              class: "inline-flex items-center gap-1.5 rounded-lg bg-saffron px-3 py-2 text-sm font-semibold text-white hover:bg-saffron-dark transition shadow-sm" do %>
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
          </svg>
          Nouveau texte
        <% end %>
      <% end %>
    </div>
  </div>

  <%# ── Grille de cartes ──────────────────────────────────────────────── %>
  <% if @texts.any? %>
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-5">
      <% @texts.each do |text| %>
        <%= link_to text_translations_path(text), class: "block" do %>
          <%= render text %>
        <% end %>
      <% end %>
    </div>
  <% else %>
    <div class="text-center py-20 text-stone-400">
      <svg class="w-12 h-12 mx-auto mb-4 text-parchment-dark" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25" />
      </svg>
      <p class="font-medium">Aucun texte trouvé</p>
      <p class="text-sm mt-1">Essayez de modifier les filtres</p>
    </div>
  <% end %>
</div>
