<div id="<%= dom_id text %>" class="book-card group flex flex-col">

  <%# ── Couverture ──────────────────────────────────────────────────── %>
  <div class="book-cover">
    <% cover_present = begin; text.preferred_cover.present?; rescue StandardError; false; end %>
    <% if cover_present %>
      <%= display_text_cover(text, class: "w-full h-full object-cover") %>
    <% else %>
      <div class="book-cover-placeholder">
        <% initial = text.title_tibetan&.first || text.title_phonetics&.first&.upcase || "P" %>
        <span class="text-tibetan opacity-40 text-4xl"><%= initial %></span>
      </div>
    <% end %>

    <%# Overlay au hover %>
    <div class="absolute inset-0 bg-stone-900/0 group-hover:bg-stone-900/20 transition-all duration-200 flex items-end justify-center pb-4 opacity-0 group-hover:opacity-100">
      <span class="text-white text-xs font-semibold bg-stone-900/60 rounded-full px-3 py-1 backdrop-blur-sm">
        Voir les traductions
      </span>
    </div>
  </div>

  <%# ── Métadonnées ─────────────────────────────────────────────────── %>
  <div class="p-3 flex flex-col gap-1 flex-1">

    <% if text.title_tibetan.present? %>
      <p class="text-tibetan text-stone-600 leading-tight" style="font-size:1.1rem; line-height:1.6rem;">
        <%= text.title_tibetan %>
      </p>
    <% end %>

    <h3 class="text-sm font-semibold text-stone-900 leading-snug line-clamp-2">
      <%= text.title_phonetics.presence || text.preferred_version_title.presence || "—" %>
    </h3>

    <% if text.title_wylie.present? %>
      <p class="text-xs text-stone-400 font-mono truncate"><%= text.title_wylie %></p>
    <% end %>

    <%# Badges %>
    <div class="flex flex-wrap gap-1 mt-auto pt-2">
      <% text.deities.limit(1).each do |d| %>
        <span class="text-xs rounded-full bg-parchment border border-parchment-dark px-2 py-0.5 text-stone-600">
          <%= d.name_english %>
        </span>
      <% end %>
      <% text.schools.limit(1).each do |s| %>
        <span class="text-xs rounded-full bg-parchment border border-parchment-dark px-2 py-0.5 text-stone-600">
          <%= s.name %>
        </span>
      <% end %>
    </div>
  </div>
</div>
