<%= render "shared/admin_header",
      title: "Dossier : #{File.basename(@proposal.folder_path)}",
      subtitle: @proposal.folder_path %>

<div class="max-w-5xl mx-auto px-4 pb-8 space-y-4">

  <% @proposal.groups.each_with_index do |group, i| %>
    <div class="rounded-lg border border-gray-200 bg-white p-5 shadow-sm">
      <div class="flex items-start justify-between gap-4">
        <div class="min-w-0">
          <% if group["title_tibetan"].present? %>
            <p class="text-tibetan text-stone-700" style="font-size:1.2rem; line-height:1.9rem;"><%= group["title_tibetan"] %></p>
          <% end %>
          <h3 class="text-base font-semibold text-gray-900">
            <%= group["title_translated"].presence || "(sans titre traduit)" %>
          </h3>
          <% if group["title_wylie"].present? %>
            <p class="text-xs text-gray-400 font-mono"><%= group["title_wylie"] %></p>
          <% end %>
        </div>
        <div class="flex shrink-0 flex-wrap gap-1.5 justify-end">
          <span class="inline-flex items-center rounded-full bg-parchment border border-parchment-dark px-2 py-0.5 text-xs text-stone-600">
            <%= group["language"] %>
          </span>
          <span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-medium
            <%= group["confidence"] == 'high'   ? 'bg-green-100 text-green-700' :
                group["confidence"] == 'medium' ? 'bg-amber-100 text-amber-700' :
                                                  'bg-red-100 text-red-700' %>">
            <%= group["confidence"] %>
          </span>
        </div>
      </div>

      <% %w[authors deities schools].each do |kind| %>
        <% names = Array(group[kind]) %>
        <% if names.any? %>
          <p class="mt-1 text-xs text-gray-500"><span class="font-medium"><%= { "authors" => "Auteurs", "deities" => "Déités", "schools" => "Écoles" }[kind] %> :</span> <%= names.join(", ") %></p>
        <% end %>
      <% end %>

      <div class="mt-3 divide-y divide-gray-100 rounded border border-gray-100">
        <% Array(group["files"]).each do |f| %>
          <% cf = @files_by_id[f["id"]] %>
          <div class="flex items-center gap-3 px-3 py-2">
            <span class="inline-flex w-20 justify-center rounded-full px-2 py-0.5 text-xs font-medium shrink-0
              <%= f["role"] == 'version'  ? 'bg-green-100 text-green-700' :
                  f["role"] == 'working'  ? 'bg-amber-100 text-amber-700' :
                  f["role"] == 'fragment' ? 'bg-orange-100 text-orange-700' :
                                            'bg-gray-100 text-gray-500' %>">
              <%= f["role"] %>
            </span>
            <div class="min-w-0 flex-1">
              <p class="truncate text-sm text-gray-800"><%= cf&.active_locations&.first&.filename || "(fichier ##{f['id']} introuvable)" %></p>
              <% if f["version_label"].present? %>
                <p class="text-xs text-gray-400">Version : <%= f["version_label"] %></p>
              <% end %>
            </div>
            <% if cf %>
              <%= link_to "Voir", nas_file_path(cf), target: "_blank",
                    class: "text-xs font-medium text-indigo-600 hover:text-indigo-800 shrink-0" %>
            <% end %>
          </div>
        <% end %>
      </div>

      <% if group["notes"].present? %>
        <p class="mt-2 text-xs text-gray-400 italic"><%= group["notes"] %></p>
      <% end %>
    </div>
  <% end %>

  <% unassigned = Array(@proposal.payload&.dig("unassigned_file_ids")) %>
  <% if unassigned.any? %>
    <div class="rounded-lg border border-gray-200 bg-gray-50 p-4">
      <p class="text-sm font-medium text-gray-600 mb-2">Fichiers écartés (bruit / non assignés)</p>
      <ul class="space-y-1">
        <% unassigned.each do |id| %>
          <li class="text-xs text-gray-500 font-mono truncate">
            <%= @files_by_id[id]&.active_locations&.first&.filename || "##{id}" %>
          </li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <% if @proposal.payload&.dig("notes").present? %>
    <p class="text-sm text-gray-500 italic"><%= @proposal.payload["notes"] %></p>
  <% end %>

  <div class="flex items-center gap-3 pt-2">
    <% if @proposal.proposed? %>
      <%= button_to "Valider et cataloguer", accept_folder_triage_path(@proposal), method: :post,
            class: "rounded bg-green-600 px-4 py-2 text-sm font-semibold text-white hover:bg-green-700" %>
      <%= button_to "Rejeter", reject_folder_triage_path(@proposal), method: :post,
            class: "rounded bg-white border border-gray-300 px-4 py-2 text-sm font-semibold text-gray-700 hover:bg-gray-50" %>
    <% else %>
      <span class="text-sm text-gray-500">Statut : <strong><%= @proposal.status %></strong></span>
    <% end %>
    <%= link_to "← Retour à la file", folder_triage_index_path, class: "text-sm text-indigo-600 hover:underline ml-auto" %>
  </div>
</div>
