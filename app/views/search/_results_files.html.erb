<div class="search-results-block">
  <p class="search-block-label">Fichiers (Active Storage) <span class="search-block-count"><%= @files.count %></span></p>
  <div class="search-results-grid">
    <% @files.each do |file| %>
      <div class="search-result-card">
        <span class="search-result-badge"><%= number_to_human_size(file.byte_size) %></span>
        <h5 class="search-result-title"><%= file.filename %></h5>
        <%= link_to rails_blob_path(file, disposition: "attachment"),
              class: "mt-auto inline-flex items-center gap-1 text-xs text-saffron hover:text-saffron-dark font-medium transition" do %>
          Télécharger
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M3 17a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm3.293-7.707a1 1 0 011.414 0L9 10.586V3a1 1 0 112 0v7.586l1.293-1.293a1 1 0 111.414 1.414l-3 3a1 1 0 01-1.414 0l-3-3a1 1 0 010-1.414z" clip-rule="evenodd" />
          </svg>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
