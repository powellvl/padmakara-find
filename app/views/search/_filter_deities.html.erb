<div class="search-filter-group">
  <p class="search-filter-label">Déités</p>
  <div class="search-pills">
    <%= form.collection_check_boxes :deity_ids, @deities, :id, :name_english, { checked: @selected_deity_ids } do |b| %>
      <label class="pill-filter" data-category="deity" data-action="click->search#togglePill">
        <%= b.check_box(class: "pill-checkbox") %>
        <span class="pill-content"><%= b.text %></span>
      </label>
    <% end %>
  </div>
</div>
