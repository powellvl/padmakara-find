<div class="search-results-block">
  <p class="search-block-label">Versions <span class="search-block-count"><%= @versions.count %></span></p>
  <div class="search-results-grid">
    <% @versions.each do |version| %>
      <%= link_to text_translation_version_path(version.translation.text, version.translation, version),
            class: "search-result-card group" do %>
        <span class="search-result-badge"><%= version.translation.language.name %></span>
        <h5 class="search-result-title"><%= version.title.presence || version.name %></h5>
        <% if version.subtitle.present? %>
          <p class="text-xs text-stone-400 mt-0.5 truncate"><%= version.subtitle %></p>
        <% end %>
        <span class="search-result-arrow group-hover:text-saffron">→</span>
      <% end %>
    <% end %>
  </div>
</div>
