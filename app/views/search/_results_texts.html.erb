<div class="search-results-block">
  <p class="search-block-label">Textes <span class="search-block-count"><%= @texts.count %></span></p>
  <div class="search-results-grid">
    <% @texts.each do |text| %>
      <%= link_to text_translations_path(text), class: "search-result-card group" do %>
        <% if text.title_tibetan.present? %>
          <p class="text-tibetan text-stone-500 leading-tight mb-1" style="font-size:1rem;line-height:1.5rem;"><%= text.title_tibetan %></p>
        <% end %>
        <h5 class="search-result-title"><%= text.title_phonetics.presence || text.title_tibetan %></h5>
        <% if text.title_wylie.present? %>
          <p class="text-xs text-stone-400 font-mono mt-0.5 truncate"><%= text.title_wylie %></p>
        <% end %>
        <span class="search-result-arrow group-hover:text-saffron">→</span>
      <% end %>
    <% end %>
  </div>
</div>
