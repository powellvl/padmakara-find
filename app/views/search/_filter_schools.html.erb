<div class="search-filter-group">
  <p class="search-filter-label">Écoles</p>
  <div class="search-pills">
    <%= form.collection_check_boxes :school_ids, @schools, :id, :name, { checked: @selected_school_ids } do |b| %>
      <label class="pill-filter" data-category="school" data-action="click->search#togglePill">
        <%= b.check_box(class: "pill-checkbox") %>
        <span class="pill-content"><%= b.text %></span>
      </label>
    <% end %>
  </div>
</div>
